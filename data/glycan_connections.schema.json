{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "glyco-connectivity-1.0"
    },
    "created_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "ccd_companion": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "geometry": {
          "type": "string"
        }
      },
      "required": [
        "filename",
        "sha256",
        "geometry"
      ],
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ccd_components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ccd_component"
      }
    },
    "datasets": {
      "type": "object",
      "properties": {
        "A": {
          "$ref": "#/$defs/dataset"
        },
        "B": {
          "$ref": "#/$defs/dataset"
        }
      },
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 1
    },
    "examples": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "created_date",
    "purpose",
    "ccd_companion",
    "conventions",
    "ccd_components",
    "datasets",
    "cases",
    "examples",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymous covalent glycoprotein connectivity v1.0",
  "$defs": {
    "ccd_atom": {
      "type": "object",
      "properties": {
        "atom_name": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "formal_charge": {
          "type": "integer"
        },
        "leaving_atom": {
          "type": "boolean"
        },
        "stereo_config": {
          "enum": [
            "R",
            "S",
            "N"
          ]
        },
        "aromatic": {
          "type": "boolean"
        }
      },
      "required": [
        "atom_name",
        "element",
        "formal_charge",
        "leaving_atom",
        "stereo_config",
        "aromatic"
      ],
      "additionalProperties": false
    },
    "ccd_bond": {
      "type": "object",
      "properties": {
        "atom_1": {
          "type": "string"
        },
        "atom_2": {
          "type": "string"
        },
        "bond_order": {
          "enum": [
            "SING",
            "DOUB",
            "TRIP",
            "AROM"
          ]
        },
        "stereo_config": {
          "enum": [
            "N",
            "E",
            "Z"
          ]
        },
        "aromatic": {
          "type": "boolean"
        }
      },
      "required": [
        "atom_1",
        "atom_2",
        "bond_order",
        "stereo_config",
        "aromatic"
      ],
      "additionalProperties": false
    },
    "ccd_component": {
      "type": "object",
      "properties": {
        "ccd_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "atoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ccd_atom"
          },
          "minItems": 1
        },
        "bonds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ccd_bond"
          },
          "minItems": 0
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_kind": {
          "type": "string"
        },
        "chemical_definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "ccd_id",
        "name",
        "type",
        "atoms",
        "bonds",
        "source_sha256",
        "source_kind",
        "chemical_definition_sha256"
      ],
      "additionalProperties": false
    },
    "glycan_node": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "ccd_id": {
          "type": "string"
        },
        "leaving_atom_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "expected_reacted_heavy_atom_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "observed_atom_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "node_id",
        "ccd_id",
        "leaving_atom_names",
        "expected_reacted_heavy_atom_names",
        "observed_atom_names"
      ],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "protein_chain_id": {
          "const": "P1"
        },
        "protein_residue_index": {
          "type": "integer",
          "minimum": 1
        },
        "protein_ccd_id": {
          "type": "string"
        },
        "protein_atom": {
          "type": "string"
        },
        "glycan_node_id": {
          "type": "string"
        },
        "glycan_atom": {
          "type": "string"
        },
        "bond_order": {
          "const": "SING"
        }
      },
      "required": [
        "protein_chain_id",
        "protein_residue_index",
        "protein_ccd_id",
        "protein_atom",
        "glycan_node_id",
        "glycan_atom",
        "bond_order"
      ],
      "additionalProperties": false
    },
    "glycosidic_bond": {
      "type": "object",
      "properties": {
        "node_1": {
          "type": "string"
        },
        "atom_1": {
          "type": "string"
        },
        "node_2": {
          "type": "string"
        },
        "atom_2": {
          "type": "string"
        },
        "bond_order": {
          "const": "SING"
        }
      },
      "required": [
        "node_1",
        "atom_1",
        "node_2",
        "atom_2",
        "bond_order"
      ],
      "additionalProperties": false
    },
    "glycan": {
      "type": "object",
      "properties": {
        "glycan_id": {
          "type": "string"
        },
        "root_node_id": {
          "type": "string"
        },
        "link_type": {
          "enum": [
            "N-Glycosylation",
            "O-Glycosylation"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glycan_node"
          },
          "minItems": 1
        },
        "attachment": {
          "$ref": "#/$defs/attachment"
        },
        "bonds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glycosidic_bond"
          },
          "minItems": 0
        },
        "resolved_fragment_only": {
          "const": true
        }
      },
      "required": [
        "glycan_id",
        "root_node_id",
        "link_type",
        "nodes",
        "attachment",
        "bonds",
        "resolved_fragment_only"
      ],
      "additionalProperties": false
    },
    "protein": {
      "type": "object",
      "properties": {
        "id": {
          "const": "P1"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "ccd_id": {
                "type": "string"
              }
            },
            "required": [
              "position",
              "ccd_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "sequence",
        "modifications"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^GLYCO_[0-9a-f]{16}$"
        },
        "chemical_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "datasets": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B"
            ]
          },
          "minItems": 1
        },
        "msa_query": {
          "type": "object",
          "properties": {
            "sequence_id": {
              "type": "string",
              "pattern": "^GPSEQ_[0-9a-f]{16}$"
            },
            "sequence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "query_length": {
              "type": "integer",
              "minimum": 1
            },
            "within_current_le2000_search_subset": {
              "type": "boolean"
            }
          },
          "required": [
            "sequence_id",
            "sequence_sha256",
            "query_length",
            "within_current_le2000_search_subset"
          ],
          "additionalProperties": false
        },
        "protein": {
          "$ref": "#/$defs/protein"
        },
        "glycans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glycan"
          },
          "minItems": 1
        },
        "additional_covalent_bonds": {
          "type": "array",
          "maxItems": 0
        },
        "scope": {
          "type": "object",
          "properties": {
            "type": {
              "const": "single_protein_chain"
            },
            "non_covalent_partners_included": {
              "const": false
            },
            "experimental_coordinates_included": {
              "const": false
            },
            "unobserved_terminal_sugars_imputed": {
              "const": false
            }
          },
          "required": [
            "type",
            "non_covalent_partners_included",
            "experimental_coordinates_included",
            "unobserved_terminal_sugars_imputed"
          ],
          "additionalProperties": false
        },
        "reference_quality": {
          "type": "object",
          "properties": {
            "local_density_certified": {
              "const": false
            },
            "observed_atom_names_are_scoring_masks_not_coordinate_restraints": {
              "const": true
            },
            "observation_scope": {
              "const": "one_selected_reference_per_case_not_all_equivalent_copies"
            }
          },
          "required": [
            "local_density_certified",
            "observed_atom_names_are_scoring_masks_not_coordinate_restraints",
            "observation_scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "case_id",
        "chemical_input_sha256",
        "datasets",
        "msa_query",
        "protein",
        "glycans",
        "additional_covalent_bonds",
        "scope",
        "reference_quality"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "unique_protein_query_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "case_ids_within_current_le2000_search_subset": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "case_ids",
        "unique_protein_query_ids",
        "case_ids_within_current_le2000_search_subset"
      ],
      "additionalProperties": false
    }
  }
}
